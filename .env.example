# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Optional) External backend URL if frontend is deployed on Vercel and backend on Render/VPS
# Leave empty if running full-stack or using Vercel Serverless Functions
VITE_API_URL=

# Google Identity Services (GIS) OAuth Client ID
# Frontend (Vercel): VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
# Backend (Render): GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Email Configuration (Resend & SMTP) - Can also be set in Admin Dashboard
RESEND_API_KEY=
SENDER_EMAIL="noreply@riadataleata.com"
SENDER_NAME="جمعية ريادة العطاء لخدمة الإنسان بالعسيلة"
EMAIL_REPLY_TO="riadataleata@gmail.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Permanent Storage Configuration (PostgreSQL & Cloudflare R2)
# ==============================================================================
# PostgreSQL Connection URL (Render / Neon / Supabase / Self-hosted)
# Used by permanent database adapter and schema migrations.
# Example format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=

# Storage Backend Selector: 'json' (default baseline) or 'postgres' (permanent store)
STORAGE_BACKEND="json"

# Cloudflare R2 Permanent Attachments Storage (S3-Compatible)
# Obtain these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="riadataleata-attachments"
R2_PUBLIC_DOMAIN=""

# Disaster Recovery & Backup Passphrase (AES-256-GCM encryption)
BACKUP_ENCRYPTION_PASSPHRASE="your_secure_random_backup_passphrase_here"

