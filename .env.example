# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: (Optional) External backend URL if frontend is deployed on Vercel and backend on Render/VPS
# Leave empty if running full-stack or using Vercel Serverless Functions
VITE_API_URL=

# Google Identity Services (GIS) OAuth Client ID
# Frontend (Vercel): VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
# Backend (Render): GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Email Configuration (Resend & SMTP) - Can also be set in Admin Dashboard
RESEND_API_KEY=
SENDER_EMAIL="noreply@riadataleata.com"
SENDER_NAME="جمعية ريادة العطاء لخدمة الإنسان بالعسيلة"
EMAIL_REPLY_TO="riadataleata@gmail.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ==============================================================================
# Permanent Storage Configuration (PostgreSQL & AWS S3 / Cloudflare R2)
# ==============================================================================
# PostgreSQL Connection URL (Render / Neon / Supabase / Self-hosted)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Storage Backend Selector: 'postgres' (Neon Production) or 'json' (local fallback)
STORAGE_BACKEND="postgres"

# Object Storage Provider: 's3' (AWS S3 Riyadh / compatible) or 'r2' (Cloudflare R2)
STORAGE_PROVIDER="s3"

# ------------------------------------------------------------------------------
# Option A: AWS S3 (Recommended: Riyadh Region me-central-1 for Saudi PDPL Compliance)
# ------------------------------------------------------------------------------
AWS_REGION="me-central-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id_here"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key_here"
AWS_BUCKET_NAME="riadataleata-secure-riyadh"
# Optional S3 Endpoint (only if using private/custom S3-compatible service)
# AWS_ENDPOINT="https://s3.me-central-1.amazonaws.com"
# S3_FORCE_PATH_STYLE="false"

# ------------------------------------------------------------------------------
# Option B: Cloudflare R2 (S3-Compatible)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="riadataleata-attachments"
R2_CUSTOM_DOMAIN=""
R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# Storage Security & Enforcement
# ------------------------------------------------------------------------------
# Set to "true" on Render to block silent fallback to ephemeral disk:
REQUIRE_PERMANENT_STORAGE="true"
REQUIRE_R2_STORAGE="true"

# Disaster Recovery & Backup Passphrase (AES-256-GCM encryption)
BACKUP_ENCRYPTION_PASSPHRASE="your_secure_random_backup_passphrase_here"



