+    "accessAuditLogs",
+    "permissionChangeLogs",
+    "developerErrorLogs",
+    "customFields",
+    "userDepartmentAccess"
+  ];
+
+  for (const key of defaultArrayKeys) {
+    if (!Array.isArray(db[key])) {
+      db[key] = [];
+      modified = true;
+    }
+  }
+
+  // Ensure default objects
+  if (!db.systemSettings || typeof db.systemSettings !== "object") {
+    db.systemSettings = {
