+      alert("حدث خطأ أثناء تصدير الصورة، يرجى إعادة المحاولة.");
+    } finally {
+      setIsExporting(false);
+    }
+  };
+
+  const drawFallbackBackground = (ctx: CanvasRenderingContext2D, w: number, h: number, face: 'front' | 'back') => {
