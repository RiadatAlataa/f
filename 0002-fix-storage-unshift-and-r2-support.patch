+                    />
+                  </div>
+                  <span className="text-[10px] font-bold text-neutral-800 dark:text-neutral-200 block truncate">
+                    {pr.name}
+                  </span>
+                </button>
+              ))}
+            </div>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
