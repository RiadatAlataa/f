+      conv.unreadCount[userId] = 0;
+    }
+  }
+
+  if (db.chatMessages) {
+    db.chatMessages.forEach((m: any) => {
+      if (m.conversationId === conversationId && m.senderId !== userId) {
+        m.status = "read";
+      }
+    });
+  }
+
+  writeDb(db);
+  res.json({ status: "success", db });
+});
