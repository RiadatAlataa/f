+      headers: { "Authorization": `Bearer ${hrSession.token}` },
+      body: { 
+        employeeId: "emp-test", 
+        employeeName: "موظف اختبار الموارد البشرية", 
+        date: "2026-10-26", 
+        checkInTime: "08:00", 
+        checkOutTime: "16:00", 
+        status: "present" 
