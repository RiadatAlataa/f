+  init.waitlistVolunteerIds = (init.waitlistVolunteerIds || []).filter((vId: string) => vId !== reqObj.volunteerId);
+
+  reqObj.status = action;
+
+  if (action === "accepted") {
+    init.acceptedVolunteerIds.push(reqObj.volunteerId);
