+        try {
+          const bgImg = new Image();
+          bgImg.crossOrigin = "anonymous";
+          await new Promise<void>((resolve, reject) => {
+            bgImg.onload = () => resolve();
+            bgImg.onerror = () => resolve(); // fallback on error
+            bgImg.src = bgImgUrl;
