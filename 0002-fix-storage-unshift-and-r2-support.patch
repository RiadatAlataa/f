+      grad.addColorStop(0.5, "#F0F6FE");
+      grad.addColorStop(1, "#EBF3FE");
+    }
+    ctx.fillStyle = grad;
+    ctx.fillRect(0, 0, w, h);
+  };
+
+  // Handle Print Action (Both Front & Back Faces side by side with CR80 dimensions)
+  const handlePrint = () => {
