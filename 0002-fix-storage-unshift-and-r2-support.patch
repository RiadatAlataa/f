+  console.log('========================================================================\n');
+
+  if (passed !== total) {
+    process.exit(1);
+  }
+  process.exit(0);
+}
+
+runStagingVerificationSuite().catch(err => {
+  console.error('[FATAL SUITE ERROR]:', err);
