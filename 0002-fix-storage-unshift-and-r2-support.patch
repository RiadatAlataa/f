+  const rateCheck = checkRateLimit('login', `bootstrap_${clientIp}`, 5, 60000);
+  if (!rateCheck.allowed) {
+    return res.status(429).json({
+      ok: false,
+      error: `تم تجاوز الحد الأقصى للمحاولات. يرجى المحاولة بعد ${rateCheck.retryAfterSec || 60} ثانية.`,
