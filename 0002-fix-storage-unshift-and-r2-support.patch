diff --git a/index.html b/index.html
new file mode 100644
index 0000000..886ecb3
--- /dev/null
+++ b/index.html
@@ -0,0 +1,36 @@
+<!doctype html>
+<html lang="ar" dir="rtl">
+  <head>
+    <meta charset="UTF-8" />
+    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
+    <title>جمعية ريادة العطاء لخدمة الإنسان بالعسيلة - البوابة الرسمية</title>
+    <meta name="description" content="البوابة الرسمية لجمعية ريادة العطاء لخدمة الإنسان بالعسيلة - إدارة المبادرات، المستفيدين، المتطوعين، والخدمات الإنسانية والتنموية" />
+    <meta property="og:title" content="جمعية ريادة العطاء لخدمة الإنسان بالعسيلة" />
+    <meta property="og:description" content="البوابة الرسمية لجمعية ريادة العطاء لخدمة الإنسان بالعسيلة" />
+    <link rel="preload" href="/fonts/LyonArabic-Bold.woff2" as="font" type="font/woff2" crossorigin />
+    <link rel="preload" href="/fonts/LyonArabic-Regular.woff2" as="font" type="font/woff2" crossorigin />
+    <!-- Google Identity Services (GIS) Web SDK -->
+    <script src="https://accounts.google.com/gsi/client" async defer></script>
+    <!-- Prevent Theme Flash (FOUC) -->
+    <script>
+      (function() {
+        try {
+          var saved = localStorage.getItem('reyadat_theme');
+          var isDark = saved ? saved === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
+          if (isDark) {
+            document.documentElement.classList.add('dark');
+            document.body && document.body.classList.add('dark');
+          } else {
+            document.documentElement.classList.remove('dark');
+            document.body && document.body.classList.remove('dark');
+          }
+        } catch (e) {}
+      })();
+    </script>
+  </head>
+  <body>
+    <div id="root"></div>
+    <script type="module" src="/src/main.tsx"></script>
+  </body>
+</html>
+
