+++ b/scripts/test-boot-scenarios.ts
@@ -0,0 +1,205 @@
+import { spawn } from 'child_process';
+import http from 'http';
+
+interface ScenarioResult {
+  scenario: string;
+  env: Record<string, string>;
+  exitCode: number | null;
+  serverRunning: boolean;
+  healthStatus: number | null;
+  healthBody: any;
+  operationalApiStatus: number | null;
+  logs: string[];
+}
+
+function makeRequest(port: number, path: string): Promise<{ statusCode: number; body: any }> {
+  return new Promise((resolve, reject) => {
+    const req = http.get(`http://127.0.0.1:${port}${path}`, (res) => {
+      let data = '';
+      res.on('data', chunk => data += chunk);
+      res.on('end', () => {
+        try {
+          resolve({ statusCode: res.statusCode || 0, body: JSON.parse(data) });
+        } catch {
+          resolve({ statusCode: res.statusCode || 0, body: data });
+        }
+      });
+    });
+    req.on('error', reject);
+    req.setTimeout(2000, () => {
+      req.destroy();
+      reject(new Error('Request timed out'));
+    });
+  });
+}
+
+function runServerScenario(
+  scenarioName: string,
+  envVars: Record<string, string>,
+  port: number,
+  durationMs: number = 4000
+): Promise<ScenarioResult> {
+  return new Promise((resolve) => {
+    const logs: string[] = [];
+    const mergedEnv: Record<string, string> = {
+      ...process.env,
+      PORT: String(port),
+      ...envVars
+    };
+
+    const child = spawn('node', ['dist/server.cjs'], {
+      env: mergedEnv,
+      stdio: ['ignore', 'pipe', 'pipe']
+    });
+
+    child.stdout.on('data', (d) => {
+      const text = d.toString();
+      logs.push(text);
+    });
+
+    child.stderr.on('data', (d) => {
+      const text = d.toString();
+      logs.push(`[STDERR] ${text}`);
+    });
+
+    let exited = false;
+    let exitCode: number | null = null;
+
+    child.on('exit', (code) => {
+      exited = true;
+      exitCode = code;
+    });
+
+    // Wait 2.5s for server to start, then make HTTP requests
+    setTimeout(async () => {
+      let healthStatus: number | null = null;
+      let healthBody: any = null;
+      let operationalApiStatus: number | null = null;
