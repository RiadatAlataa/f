+    (userId && (e.id === userId || e.employeeNumber === userId)) ||
+    (nationalId && e.nationalId === nationalId)
+  );
+
+  if (emp) {
+    return {
+      isAuthenticated: true,
+      isSuperAdmin: false,
+      role: 'employee',
+      userId: emp.id,
+      userName: emp.name,
+      jobTitle: emp.jobTitle || 'موظف إدارة',
