+/**
+ * USER_UPDATE_PRIVILEGE_GUARD
+ * Strict anti-privilege-escalation and top management account guard.
+ * Prevents non-super-admins from:
+ * 1. Elevating their own or any user's role to 'admin', 'super_admin', or 'operations_manager'.
+ * 2. Granting critical administrative permissions ('super_admin', 'all_permissions', 'manage_permissions', 'all').
+ * 3. Modifying, disabling, or resetting credentials of Top Management (mosa, admin-user, ops-manager).
+ * 4. Managing staff across departments without cross_department_access.
+ */
+export const USER_UPDATE_PRIVILEGE_GUARD = {
+  validateUpdate: (
+    callerContext: any,
+    targetUserId: string,
+    updateData: any,
+    res?: any
+  ): { allowed: boolean; error?: string; code?: string } => {
+    if (!callerContext || !callerContext.isAuthenticated) {
+      const err = "غير مصرح: يلزم تسجيل الدخول بجلسة موثقة لتعديل أو إدارة المستخدمين.";
+      if (res) res.status(401).json({ error: err, code: "UNAUTHORIZED" });
+      return { allowed: false, error: err, code: "UNAUTHORIZED" };
+    }
+
+    const isSuper = Boolean(callerContext.isSuperAdmin || callerContext.role === 'admin');
+    const isOps = Boolean(callerContext.isOperationsManager || callerContext.role === 'operations_manager');
+    const callerPerms: string[] = callerContext.permissions || [];
+    const hasManageStaff = callerPerms.includes('manage_staff') || callerPerms.includes('all_permissions') || isSuper || isOps;
+
+    if (!hasManageStaff) {
+      const err = "مرفوض: ليس لديك صلاحية إدارة الموظفين والمستخدمين (manage_staff).";
+      if (res) res.status(403).json({ error: err, code: "FORBIDDEN_MANAGE_STAFF" });
+      return { allowed: false, error: err, code: "FORBIDDEN_MANAGE_STAFF" };
+    }
+
+    // Top Management Accounts protection
+    const topManagementIds = ['mosa', 'admin-user', 'admin', 'ops-manager', 'operations_manager', '1000000000', '1000000099', '1020000000'];
+    const cleanTarget = String(targetUserId || '').toLowerCase().trim();
+    const isTargetTopMgmt = topManagementIds.includes(cleanTarget);
+
+    if (isTargetTopMgmt && !isSuper) {
+      const err = "حظر أمني صارم: لا يمكن تعديل أو تعطيل أو تغيير صلاحيات حسابات الإدارة العليا إلا من قبل مسؤول النظام الأعلى (Super Admin).";
+      if (res) res.status(403).json({ error: err, code: "FORBIDDEN_TOP_MANAGEMENT_PROTECTION" });
+      return { allowed: false, error: err, code: "FORBIDDEN_TOP_MANAGEMENT_PROTECTION" };
+    }
+
+    // Role Escalation Check
+    const requestedRole = String(updateData?.role || '').toLowerCase().trim();
+    if (['admin', 'super_admin', 'operations_manager'].includes(requestedRole) && !isSuper) {
+      const err = "حظر تصعيد الصلاحيات: لا يمكن منح دور المدير العام أو مدير العمليات إلا بواسطة الإدارة العليا حصراً.";
+      if (res) res.status(403).json({ error: err, code: "PRIVILEGE_ESCALATION_BLOCKED" });
+      return { allowed: false, error: err, code: "PRIVILEGE_ESCALATION_BLOCKED" };
+    }
+
+    // Permission Escalation Check
+    const requestedPerms = Array.isArray(updateData?.permissions) ? updateData.permissions : [];
+    const hasEscalatedPerm = requestedPerms.some((p: string) => 
+      ['super_admin', 'all_permissions', 'manage_permissions', 'operations_manager', 'all'].includes(p)
+    );
+    if (hasEscalatedPerm && !isSuper) {
+      const err = "حظر تصعيد الصلاحيات: لا يمكن منح صلاحية الإدارة العليا (super_admin) أو الصلاحيات الشاملة إلا من قبل الإدارة العليا حصراً.";
+      if (res) res.status(403).json({ error: err, code: "PRIVILEGE_ESCALATION_BLOCKED" });
+      return { allowed: false, error: err, code: "PRIVILEGE_ESCALATION_BLOCKED" };
+    }
+
+    // Department Isolation Check for Department Managers with manage_staff
+    if (!isSuper && !isOps && !callerPerms.includes('cross_department_access')) {
+      const targetDept = updateData?.departmentId || updateData?.primaryDepartmentId;
+      const allowedDepts = callerContext.allowedDepartmentIds || (callerContext.primaryDepartmentId ? [callerContext.primaryDepartmentId] : []);
+      if (targetDept && !allowedDepts.includes(targetDept)) {
+        const err = `مرفوض: لا يمكنك إدارة أو نقل موظفين خارج نطاق إدارتك المعتمدة (${callerContext.primaryDepartmentId}).`;
+        if (res) res.status(403).json({ error: err, code: "FORBIDDEN_CROSS_DEPARTMENT" });
+        return { allowed: false, error: err, code: "FORBIDDEN_CROSS_DEPARTMENT" };
+      }
+    }
+
+    return { allowed: true };
+  }
+};
+
+// 2. Authorization Check & Audit Logging Middleware/Helper
+function checkDepartmentPermission(
+  req: any,
+  res: any,
+  targetDepartmentId?: string,
+  requiredPermission?: string,
+  resourceName: string = 'البيانات'
+): { allowed: boolean; context: any } {
+  const context = getUserAccessContext(req);
+  const db = readDb();
+
+  const logAudit = (status: 'allowed' | 'denied', notes?: string) => {
+    if (!db.accessAuditLogs) db.accessAuditLogs = [];
+    db.accessAuditLogs.unshift({
+      id: "audit-" + Date.now() + "-" + Math.random().toString(36).substring(2, 6),
+      timestamp: new Date().toISOString(),
+      userId: context.userId,
+      userName: context.userName,
+      userRole: context.role,
+      userDepartmentId: context.primaryDepartmentId,
+      targetDepartmentId: targetDepartmentId || context.primaryDepartmentId || 'all',
+      action: requiredPermission || 'access',
+      resource: resourceName,
+      endpoint: req.originalUrl || req.path || req.url,
+      status,
+      ip: req.ip || req.headers['x-forwarded-for'] || '127.0.0.1',
+      device: (req.headers['user-agent'] || 'Web Client').substring(0, 100),
+      notes: notes || (status === 'allowed' ? 'تم اعتماد الوصول بناءً على الصلاحيات المعرفة' : 'تم حظر العملية: محاولة وصول غير مصرح بها خارج نطاق الإدارة')
+    });
+    if (db.accessAuditLogs.length > 250) db.accessAuditLogs.length = 250;
+    writeDb(db);
+  };
+
+  // 0. Strict Authentication Barrier: Deny unauthenticated requests immediately with 401
+  if (!context.isAuthenticated) {
+    logAudit('denied', 'محاولة وصول غير مصرح بها: المستخدم غير مسجل دخول أو الجلسة منتهية أو تم تزييف الهوية');
+    if (res) {
+      res.status(401).json({
+        error: "غير مصرح: يجب تسجيل الدخول وإرسال رمز جلسة صالح (Authorization Bearer / x-session-token) للمتابعة.",
+        code: 'UNAUTHORIZED'
+      });
+    }
+    return { allowed: false, context };
+  }
+
+  // Super Admin & Operations Manager bypass all departmental checks
+  if (context.isSuperAdmin || context.isOperationsManager || context.role === 'operations_manager') {
+    return { allowed: true, context };
+  }
+
+  // Department Scope Isolation Check
+  if (targetDepartmentId && targetDepartmentId !== 'all') {
+    const isAllowedDept = context.allowedDepartmentIds && context.allowedDepartmentIds.includes(targetDepartmentId);
+    if (!isAllowedDept) {
+      logAudit('denied', `محاولة وصول غير مصرح بها إلى بيانات إدارة (${targetDepartmentId}) للمستخدم (${context.userName}) المقيد في (${context.primaryDepartmentId})`);
+      if (res) {
+        res.status(403).json({
+          error: `تم رفض الوصول: ليس لديك تصريح لعرض أو تعديل بيانات هذه الإدارة (${targetDepartmentId}). الوصول مقتصر على إدارتك المعينة (${context.primaryDepartmentId}).`,
+          code: 'FORBIDDEN_DEPARTMENT_SCOPE',
+          userDepartment: context.primaryDepartmentId,
+          targetDepartment: targetDepartmentId
+        });
+      }
+      return { allowed: false, context };
+    }
+  }
+
+  // Granular Permission Key Check (supports both specific departmental keys & operation aliases)
+  if (requiredPermission) {
+    const userPerms: string[] = context.permissions || [];
+    const hasExplicit = userPerms.includes(requiredPermission as any);
+    
+    // Check alias matching
+    const hasAlias = userPerms.some((p: string) => {
+      if (p === 'super_admin' || p === 'all_permissions') return true;
+      if (requiredPermission === 'create_data') {
+        return p.includes('_add_') || p.includes('_create') || p === 'items' || p === 'create_initiatives';
+      }
+      if (requiredPermission === 'edit_data') {
+        return p.includes('_edit_') || p.includes('_manage_') || p.includes('_points') || p.includes('_quantities');
+      }
+      if (requiredPermission === 'delete_data') {
+        return p.includes('_delete_');
+      }
+      if (requiredPermission === 'view_department') {
+        return p.includes('_view_') || p.includes('_audit_') || p.includes('view_stock');
+      }
+      if (requiredPermission === 'approve_data') {
+        return p.includes('_approve_') || p.includes('_evaluations') || p.includes('_leaves');
+      }
+      if (requiredPermission === 'disburse_data') {
+        return p.includes('_disburse') || p === 'outbound' || p.includes('_payroll') || p.includes('_record_receipt');
+      }
+      if (requiredPermission === 'receive_data') {
+        return p.includes('_receive') || p === 'inbound' || p.includes('_record_receipt');
+      }
+      if (requiredPermission === 'print_data') {
+        return p.includes('_print') || p.includes('_barcode');
+      }
+      if (requiredPermission === 'view_reports') {
+        return p.includes('_reports') || p.includes('_audit_') || p === 'audit';
+      }
+      if (requiredPermission === 'export_excel' || requiredPermission === 'export_pdf') {
+        return p.includes('_export');
+      }
+      if (requiredPermission === 'manage_staff') {
+        return p.includes('_staff') || p.includes('_files');
+      }
+      if (requiredPermission === 'manage_tasks') {
+        return p.includes('_manage_') || p.includes('_attendance');
+      }
+      // If requiredPermission is specific (e.g. warehouse_disburse), check if user has the legacy equivalent
+      if (requiredPermission.includes('disburse') && (p === 'disburse_data' || p === 'outbound')) return true;
+      if (requiredPermission.includes('receive') && (p === 'receive_data' || p === 'inbound')) return true;
+      if (requiredPermission.includes('add_') && (p === 'create_data' || p === 'items')) return true;
+      if (requiredPermission.includes('edit_') && p === 'edit_data') return true;
+      if (requiredPermission.includes('delete_') && p === 'delete_data') return true;
+      if (requiredPermission.includes('reports') && p === 'view_reports') return true;
+      if (requiredPermission.includes('print') && p === 'print_data') return true;
+      if (requiredPermission.includes('export') && (p === 'export_excel' || p === 'export_pdf')) return true;
+      return false;
+    });
+
+    if (!hasExplicit && !hasAlias) {
+      logAudit('denied', `المستخدم (${context.userName}) لا يملك صلاحية (${requiredPermission}) لإجراء هذه العملية على ${resourceName}`);
+      if (res) {
+        res.status(403).json({
+          error: `ليس لديك الصلاحية المطلوبة (${requiredPermission}) لإجراء هذه العملية على ${resourceName}. يرجى مراجعة إدارة النظام.`,
+          code: 'FORBIDDEN_PERMISSION',
+          requiredPermission,
+          userPermissions: context.permissions
+        });
+      }
+      return { allowed: false, context };
+    }
+  }
+
+  // Access is verified and permitted
+  logAudit('allowed', `وصول معتمد بنجاح إلى ${resourceName}`);
+  return { allowed: true, context };
+}
