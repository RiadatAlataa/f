+    delete process.env.APP_DB_PATH;
+    if (fs.existsSync(sandboxDir)) {
+      fs.rmSync(sandboxDir, { recursive: true, force: true });
+    }
+  }
+}
+
+runSessionRestartTest().catch((err) => {
+  console.error("Test error:", err);
+  process.exit(1);
+});
