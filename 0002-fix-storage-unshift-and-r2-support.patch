+    );
+
+    // -------------------------------------------------------------
+    // STEP 8: Server Restart & Memory Eviction Verification
+    // -------------------------------------------------------------
+    // Verify getPostgresHealthReport queries directly from PostgreSQL
+    const healthReport = await getPostgresHealthReport();
+    const healthOk = 
