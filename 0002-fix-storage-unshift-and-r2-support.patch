+    console.log("================================================================================\n");
+
+    // 1. HR Leave Action
+    const hrSession = createServerSession({ 
+      id: "hr-director", 
+      role: "department_admin", 
+      departmentId: "dep-9", 
+      permissions: ["manage_staff"] 
+    }, "department_admin");
+
+    const leaveRes = await request("/api/db/hr/leaves/action", {
