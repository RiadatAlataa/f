+        noEmailCount++;
+        dispatchLogs.push({
+          beneficiaryId: ben.id,
+          beneficiaryName: ben.name,
+          email: "",
+          status: "no_email",
+          error: "لا يوجد بريد إلكتروني مسجل للمستفيد"
