+                <span>{isRetrying ? "جاري إعادة المحاولة..." : "إعادة المحاولة"}</span>
+              </button>
+            )}
+          </div>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default LoadingScreen;
