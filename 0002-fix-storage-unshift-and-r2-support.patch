+    return res.status(404).json({ error: "المشروع غير موجود في قائمة متجر الجمعية" });
+  }
+
+  const numericAmount = Number(amount);
+  const donationNumber = `DON-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
