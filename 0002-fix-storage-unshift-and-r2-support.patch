+// Server-side Session Management (session_start persistence)
+export interface ServerSession {
+  token: string;
+  userId: string;
+  role: string;
+  user: any;
+  userName?: string;
+  departmentId?: string;
+  nationalId?: string;
+  teamId?: string;
+  createdAt: number;
+  lastActive: number;
+  expiresAt: number;
+}
+
+const activeSessions = new Map<string, ServerSession>();
+
+export function createServerSession(user: any, role: string): ServerSession {
+  const token = `sess_${Date.now()}_${crypto.randomBytes(32).toString("hex")}`;
+  const now = Date.now();
+  const session: ServerSession = {
+    token,
+    userId: user?.id || 'user',
+    role: role || user?.role || 'user',
+    user,
+    userName: user?.name || user?.userName || user?.nameAr || '',
+    departmentId: user?.departmentId || user?.primaryDepartmentId || '',
+    nationalId: user?.nationalId || '',
+    teamId: user?.teamId || '',
+    createdAt: now,
+    lastActive: now,
+    expiresAt: now + (7 * 24 * 60 * 60 * 1000) // 7 days persistent session
+  };
+  activeSessions.set(token, session);
+  return session;
+}
+
+export function getServerSession(token?: string): ServerSession | null {
+  if (!token) return null;
+  const now = Date.now();
+  let session = activeSessions.get(token);
+
+  if (!session) {
+    try {
+      const db = readDb();
+      if (db && Array.isArray(db.activeSessions)) {
+        session = db.activeSessions.find((s: any) => s && s.token === token);
+        if (session) {
+          activeSessions.set(token, session);
+        }
+      }
+    } catch {}
+  }
+
+  if (!session) return null;
+  if (now > session.expiresAt) {
+    activeSessions.delete(token);
+    try {
+      const db = readDb();
+      if (db && Array.isArray(db.activeSessions)) {
+        db.activeSessions = db.activeSessions.filter((s: any) => s && s.token !== token);
+        writeDb(db);
+      }
+    } catch {}
+    return null;
+  }
+  session.lastActive = now;
+  return session;
+}
+
+export function destroyServerSession(token?: string): boolean {
+  if (!token) return false;
+  activeSessions.delete(token);
+  return true;
+}
+
+export function invalidateUserSessions(userId: string): number {
+  if (!userId) return 0;
+  let count = 0;
+  for (const [token, session] of activeSessions.entries()) {
+    if (session.userId === userId || session.user?.id === userId || session.user?.nationalId === userId) {
+      activeSessions.delete(token);
+      count++;
+    }
+  }
+  try {
+    const db = readDb();
+    if (db && Array.isArray(db.activeSessions)) {
+      const initialLen = db.activeSessions.length;
+      db.activeSessions = db.activeSessions.filter((s: any) => 
+        s && s.userId !== userId && s.user?.id !== userId && s.user?.nationalId !== userId
+      );
+      count += (initialLen - db.activeSessions.length);
+      writeDb(db);
+    }
+  } catch {}
+  return count;
+}
