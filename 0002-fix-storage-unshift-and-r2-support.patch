+        });
+
+        if (sendResult.success) {
+          sentCount++;
+          dispatchLogs.push({
+            beneficiaryId: ben.id,
+            beneficiaryName: ben.name,
+            email,
+            status: "sent"
+          });
+        } else {
+          failedCount++;
+          dispatchLogs.push({
+            beneficiaryId: ben.id,
+            beneficiaryName: ben.name,
+            email,
+            status: "failed",
+            error: sendResult.error || "خطأ أثناء إرسال البريد"
