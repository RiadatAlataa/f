+    db.issuedVolunteerCards.forEach((c: any) => {
+      if (c.volunteerId === vol.id && c.status === "active") {
+        c.status = "superseded";
+      }
+    });
+
+    const cardSeq = String(db.issuedVolunteerCards.length + 1 + idx).padStart(5, "0");
+    const cardNumber = `CRD-2026-${cardSeq}`;
