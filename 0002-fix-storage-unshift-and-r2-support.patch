+app.post("/api/db/notifications/send", (req, res) => {
+  const db = readDb();
+  const {
+    titleAr,
+    titleEn,
+    bodyAr,
+    bodyEn,
+    type, // 'normal' | 'important' | 'urgent'
+    category, // 'system' | 'support' | 'volunteer' | 'beneficiary' | 'initiative' | 'points' | 'attendance' | 'certificate' | 'announcement'
