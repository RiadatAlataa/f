+import express from "express";
+import path from "path";
+import fs from "fs";
+import { fileURLToPath } from "url";
+import crypto from "crypto";
+import bcrypt from "bcryptjs";
+import { GoogleGenAI } from "@google/genai";
+import type { 
+  Department, 
+  VolunteerTeam, 
+  Volunteer, 
+  Initiative, 
+  JoinRequest, 
+  AttendanceRecord, 
+  Evaluation, 
+  OperationLog, 
+  Notification,
+  SystemStats,
+  VolunteerApplication,
+  CertificateTemplate,
+  IssuedCertificate,
+  InitiativeRating,
+  OpportunityRequest,
+  TeamApplication,
+  OfficialLetter
+} from "./src/types";
+import { setupFinancialRoutes } from "./server/financeRoutes";
+import { setupEmailRoutes } from "./server/emailRoutes";
+import { setupWhatsAppRoutes } from "./server/whatsappRoutes";
+import { sendCentralEmail, getSanitizedEmailConfig } from "./server/emailService";
+import { 
+  initPostgresTables, 
+  getPostgresMaintenanceStatus, 
+  setPostgresMaintenanceStatus,
+  savePostgresVolunteerFileNumber,
+  getPostgresVolunteerFileNumbers,
+  isPostgresConfigured,
+  isPostgresStorageActive,
+  getPostgresSystemState,
+  savePostgresSystemState,
+  executePostgresTransactionMutation,
+  getPostgresHealthReport,
+  bootstrapCleanPostgresSystemState,
+  normalizeSystemStateCollections
+} from "./server/postgres";
+import { writeCoordinator } from "./server/writeLock";
+import { backupEngine } from "./server/backupEngine";
+import { attachmentStorage } from "./server/storage/attachmentStorage";
+
+console.log("[SERVER CORE] loading");
+
+const app = express();
+const PORT = Number(process.env.PORT) || 3000;
+
+// Enable trust proxy for Cloud Run, Nginx, Cloudflare, and custom domain proxies
+app.set('trust proxy', 1);
+
+// Ensure req.socket and req.ip are safely defined in serverless environments
+app.use((req, res, next) => {
+  if (!req.socket) {
+    req.socket = { remoteAddress: '127.0.0.1' } as any;
+  } else if (!req.socket.remoteAddress) {
+    (req.socket as any).remoteAddress = '127.0.0.1';
+  }
+  const forwarded = req.headers['x-forwarded-for'];
+  const clientIp = (typeof forwarded === 'string' ? forwarded.split(',')[0].trim() : '') || 
+                   (req.headers['x-real-ip'] as string) || 
+                   '127.0.0.1';
+  try {
+    Object.defineProperty(req, 'ip', {
+      value: clientIp,
+      writable: true,
+      configurable: true
+    });
+  } catch {}
+  next();
+});
+
+/**
+ * Strict CORS Origin Validator
+ * Enforces exact matching for official production domains and validated development hosts.
+ * Rejects any spoofed, wildcard, or untrusted external origins.
+ */
+export const isOriginAllowed = (origin?: string): boolean => {
+  if (!origin || typeof origin !== "string") return false;
+
+  let parsed: URL;
+  try {
+    parsed = new URL(origin.trim());
+  } catch {
+    return false;
+  }
+
+  const protocol = parsed.protocol.toLowerCase();
+  const hostname = parsed.hostname.toLowerCase();
+  const port = parsed.port;
+
+  // 1. Official Society Production Domains (HTTPS only)
+  if (protocol === "https:" && (hostname === "www.riadataleata.com" || hostname === "riadataleata.com")) {
+    return true;
+  }
+
+  // 2. Official Production API Host on Render (HTTPS only)
+  if (protocol === "https:" && hostname === "riadataleata-api.onrender.com") {
+    return true;
+  }
+
+  // 3. Local Development Hosts (strictly constrained ports)
+  if ((protocol === "http:" || protocol === "https:") && (hostname === "localhost" || hostname === "127.0.0.1")) {
+    if (!port || ["3000", "5173", "8080"].includes(port)) {
+      return true;
+    }
+  }
+
+  // 4. Dedicated AI Studio Development Sandbox (strictly formatted Cloud Run subdomains)
+  // Format: https://ais-dev-<id>-<project>.<region>.run.app or ais-pre-...
+  if (protocol === "https:" && /^(ais-dev|ais-pre)-[a-z0-9]+-\d+\.[a-z0-9-]+\.run\.app$/.test(hostname)) {
+    return true;
+  }
+
+  // 5. Explicitly configured APP_URL environment variable if set
+  if (process.env.APP_URL) {
+    try {
+      const appUrlParsed = new URL(process.env.APP_URL);
+      if (protocol === appUrlParsed.protocol.toLowerCase() && hostname === appUrlParsed.hostname.toLowerCase()) {
+        return true;
+      }
+    } catch {}
+  }
+
+  return false;
+};
+
+// CORS and Pre-flight Handling for Custom Domains & SSL Proxies
+app.use((req, res, next) => {
+  const reqOrigin = req.headers.origin;
+
+  // Always append Vary: Origin so intermediate caches/CDNs never mix responses between origins
+  res.header("Vary", "Origin");
+
+  if (reqOrigin) {
+    if (isOriginAllowed(reqOrigin)) {
+      res.header("Access-Control-Allow-Origin", reqOrigin);
+      res.header("Access-Control-Allow-Credentials", "true");
+      res.header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS, HEAD");
+      res.header(
+        "Access-Control-Allow-Headers",
+        "Origin, X-Requested-With, Content-Type, Accept, Authorization, x-session-token, x-user-id, x-user-role, x-user-name, x-department-id, x-national-id, x-team-id"
+      );
+      res.header("Access-Control-Max-Age", "86400");
+    } else {
+      // Untrusted Origin:
+      // STRICT: Never send Access-Control-Allow-Origin or Access-Control-Allow-Credentials
+      if (req.method === "OPTIONS") {
+        return res.status(403).json({
+          error: "CORS Forbidden: Origin not allowed",
+          origin: reqOrigin
+        });
+      }
+    }
+  }
+
+  // Handle pre-flight for allowed origin (or non-CORS pre-flight)
+  if (req.method === "OPTIONS") {
+    return res.sendStatus(204);
+  }
+
+  next();
+});
+
+app.use(express.json({ limit: "50mb" }));
+
+// Write Freeze Barrier Middleware (Protects data consistency during snapshots/migrations)
+app.use((req, res, next) => {
+  if (writeCoordinator.getIsWriteFrozen() && !['GET', 'HEAD', 'OPTIONS'].includes(req.method)) {
+    const p = req.path || '';
+    const isExempt = 
+      p.startsWith('/api/admin/freeze') ||
+      p.startsWith('/api/db/auth/login') ||
+      p.startsWith('/api/db/restore') ||
+      p.startsWith('/api/admin/restore');
+
+    if (!isExempt) {
+      return res.status(423).json({
+        ok: false,
+        error: "عمليات الكتابة والتعديل مجمدة مؤقتاً لأغراض الصيانة وحماية البيانات وأخذ النسخة الاحتياطية. النظام حالياً في وضع القراءة فقط.",
+        code: "WRITE_FROZEN_FOR_MAINTENANCE",
+        timestamp: new Date().toISOString()
+      });
+    }
+  }
+  next();
+});
+
+// PostgreSQL Boot & Awaiting Bootstrap Guard Middleware
+app.use((req, res, next) => {
+  if (isPostgresStorageActive() && isAwaitingBootstrap()) {
+    const p = req.path || '';
+    const isExempt = 
+      p.startsWith('/api/health') || 
+      p === '/api/ping' || 
+      p === '/api/admin/system/bootstrap' ||
+      !p.startsWith('/api');
+
+    if (!isExempt) {
+      return res.status(503).json({
+        ok: false,
+        status: "awaiting_bootstrap",
+        error: "قاعدة البيانات PostgreSQL متصلة بنجاح، ولكنها بانتظار إجراء التهيئة الأولية الآمنة لإنشاء أول حساب لمدير العمليات.",
+        code: "DATABASE_AWAITING_BOOTSTRAP",
+        timestamp: new Date().toISOString()
+      });
+    }
+  }
+  next();
+});
+
+// Mandatory Password Change Enforcement Barrier
+// Blocks sensitive API operations until temporary password is changed
+app.use((req, res, next) => {
+  if (!req.path.startsWith('/api')) return next();
+
+  const exempt = 
+    req.path.startsWith('/api/health') ||
+    req.path === '/api/ping' ||
+    req.path === '/api/db/auth/login' ||
+    req.path === '/api/db/auth/logout' ||
+    req.path === '/api/db/auth/change-password' ||
+    req.path === '/api/db/auth/self-change-password' ||
+    req.path === '/api/db/auth/me' ||
+    req.path === '/api/admin/system/bootstrap';
+
+  if (exempt) return next();
+
+  const authContext = getUserAccessContext(req);
+  if (authContext.isAuthenticated && (authContext as any).mustChangePassword) {
+    return res.status(403).json({
+      ok: false,
+      error: "يجب تغيير كلمة المرور المؤقتة أولاً قبل إجراء أي عمليات أو استعلامات على النظام.",
+      code: "MUST_CHANGE_PASSWORD",
+      mustChangePassword: true
+    });
+  }
+
+  next();
+});
+
+const cardTemplatesDir = path.join(process.cwd(), "public", "card_templates");
+const uploadsDir = path.join(process.cwd(), "public", "uploads");
+const licenseDir = path.join(uploadsDir, "license");
+try {
+  if (!fs.existsSync(cardTemplatesDir)) {
+    fs.mkdirSync(cardTemplatesDir, { recursive: true });
+  }
+  if (!fs.existsSync(licenseDir)) {
+    fs.mkdirSync(licenseDir, { recursive: true });
+  }
+} catch {
+  // Read-only filesystem in serverless environments
+}
+if (fs.existsSync(cardTemplatesDir)) {
+  app.use("/card_templates", express.static(cardTemplatesDir));
+}
+// ---------------------------------------------------------------------------
+// Secure Uploads Access Controller & Static Protection
+// Enforces:
+// 1. Path Traversal & Escape Prevention (Anti-ZipSlip / traversal)
+// 2. Safe Public Asset Serving (/uploads/license/*, /uploads/public/*, etc.)
+// 3. Strict Authentication & Role Authorization for Private Attachments (/uploads/volunteers/*, /uploads/beneficiaries/*, etc.)
+// ---------------------------------------------------------------------------
+app.use("/uploads", (req, res, next) => {
+  const rawPath = req.path;
+  if (!rawPath || typeof rawPath !== 'string') {
+    return res.status(400).json({ error: "مسار ملف غير صالح." });
+  }
+
+  let decodedPath = '';
+  try {
+    decodedPath = decodeURIComponent(rawPath);
+  } catch {
+    return res.status(400).json({ error: "ترميز مسار غير صالح." });
+  }
+
+  // Anti-Path Traversal Check
+  if (decodedPath.includes('..') || decodedPath.includes('\0') || decodedPath.includes('\\')) {
+    return res.status(403).json({ error: "مرفوض أمنيًا: محاولة اجتياز مسار غير مشروعة (Path Traversal Prohibited)." });
+  }
+
+  const normalizedRel = path.normalize(decodedPath).replace(/^[/\\]+/, '');
+  const resolvedTarget = path.resolve(uploadsDir, normalizedRel);
+  const resolvedUploadsDir = path.resolve(uploadsDir);
+
+  if (!resolvedTarget.startsWith(resolvedUploadsDir + path.sep) && resolvedTarget !== resolvedUploadsDir) {
+    return res.status(403).json({ error: "مرفوض أمنيًا: مسار غير مسموح." });
+  }
+
+  // Check Public vs Private Categories
+  const topSegment = normalizedRel.split(/[/\\]/)[0]?.toLowerCase();
+  const isPublicCategory = (
+    topSegment === 'license' || 
+    topSegment === 'licenses' || 
+    topSegment === 'public' || 
+    topSegment === 'cards' ||
+    normalizedRel.startsWith('license_official')
+  );
+
+  // If public category, serve publicly
+  if (isPublicCategory) {
+    if (fs.existsSync(resolvedTarget) && fs.statSync(resolvedTarget).isFile()) {
+      return res.sendFile(resolvedTarget);
+    }
+    return res.status(404).json({ error: "الملف العام المطلوب غير موجود." });
+  }
+
+  // Private Attachment Access: Authentication Required
+  const authContext = getUserAccessContext(req);
+  if (!authContext || !authContext.isAuthenticated) {
+    return res.status(401).json({
+      ok: false,
+      error: "غير مصرح: المرفق خاص وحساس ويتطلب تسجيل الدخول والصلاحيات المناسبة للاطلاع عليه.",
