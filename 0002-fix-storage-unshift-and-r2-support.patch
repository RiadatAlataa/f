+          healthStatus = h.statusCode;
+          healthBody = h.body;
+        } catch (e: any) {
+          healthBody = { error: e.message };
+        }
+
+        try {
+          const op = await makeRequest(port, '/api/volunteers');
+          operationalApiStatus = op.statusCode;
+        } catch (e: any) {}
+      }
+
+      // Terminate child
+      child.kill('SIGTERM');
+
+      setTimeout(() => {
+        resolve({
+          scenario: scenarioName,
+          env: envVars,
+          exitCode,
+          serverRunning: !exited,
+          healthStatus,
+          healthBody,
+          operationalApiStatus,
+          logs
+        });
+      }, 500);
+    }, durationMs - 500);
+  });
+}
+
+async function main() {
