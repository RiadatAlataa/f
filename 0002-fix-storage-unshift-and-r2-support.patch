+    );
+
+    destroyServerSession(session.token);
+
+  } finally {
+    writeDb(originalDb);
+    await stopServer();
+  }
+
+  console.log("\n================================================================================");
+  console.log(`   نتائج الاختبارات: ${passed} نجح | ${failed} فشل`);
+  console.log("================================================================================\n");
+
+  if (failed > 0) process.exit(1);
+}
+
+testSuite().catch((err) => {
