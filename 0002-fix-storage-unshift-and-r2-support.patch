+  if (userRole === 'volunteer' || (userId && typeof userId === 'string' && (userId.startsWith('vol-') || userId === 'volunteer-1'))) {
+    const vol = (db.volunteers || []).find((v: any) => v.id === userId || v.nationalId === nationalId || v.email === userId) || activeSession?.user;
+    return {
