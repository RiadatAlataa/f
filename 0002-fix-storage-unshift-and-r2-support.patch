+        continue;
+      }
+
+      try {
+        const sendResult = await sendCentralEmail(db, {
+          to: email,
+          recipientName: ben.name,
+          subject: `إشعار جاهزية المساعدة للاستلام - ${dist.title}`,
+          templateType: "beneficiary_aid_ready",
+          templateData: {
