+
+  if (!sessionToken) {
+    return res.status(401).json({
+      ok: false,
+      error: "غير مصرح: يلزم جلسة صالحة لتنفيذ استعادة قاعدة البيانات.",
+      code: "UNAUTHORIZED_SESSION_REQUIRED"
