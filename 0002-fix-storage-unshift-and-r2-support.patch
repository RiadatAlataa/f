+    assert(
+      attRes.status === 200 && attRes.body?.status === "success",
+      "2. تسجيل الحضور والانصراف الوظيفي في سجلات الموارد البشرية"
+    );
+
+    // 3. HR Decision Add
+    const decRes = await request("/api/db/hr/decisions/add", {
+      method: "POST",
