+/**
+ * Test Session Persistence Across Page Refreshes and Server Restarts
+ * Project: جمعية ريادة العطاء لخدمة الإنسان بالعسيلة
+ */
+
+import http from "http";
+import path from "path";
+import fs from "fs";
+
+async function runSessionRestartTest() {
