+
+        {/* 2. الاسم الكامل */}
+        <h4 className="text-xs sm:text-sm font-black text-neutral-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors leading-snug line-clamp-2 w-full">
+          {member.name}
+        </h4>
+      </div>
+
+      {/* 3. المنصب الإداري */}
