{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://riadataleata-api.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://riadataleata-api.onrender.com/api"
    },
    {
      "source": "/((?!api/|assets/|favicon|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
