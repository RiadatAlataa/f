From 2139c41b2c12201ae5178095874cae55a570ec3c Mon Sep 17 00:00:00 2001
From: RiadatAlataa <riadataleata@gmail.com>
Date: Sat, 31 Oct 2026 19:51:49 +0000
Subject: [PATCH] fix(postgres): increase connection timeout and retry for neon
 cold start, support BOOTSTRAP_ADMIN_KEY

---
 server-core.ts     | 13 +++++++++++--
 server/postgres.ts | 24 ++++++++++++++++++++++--
 2 files changed, 33 insertions(+), 4 deletions(-)

diff --git a/server-core.ts b/server-core.ts
index a324f8f..4d17c80 100644
--- a/server-core.ts
+++ b/server-core.ts
@@ -5797,8 +5797,17 @@ app.post("/api/admin/system/bootstrap", async (req, res) => {
     });
   }
 
-  const token = (req.headers['x-bootstrap-token'] as string) || req.body?.bootstrapToken || req.body?.bootstrapKey;
-  const configuredSecret = process.env.BOOTSTRAP_ADMIN_KEY || process.env.BOOTSTRAP_TOKEN;
+  const authHeader = req.headers['authorization'];
+  const bearerToken = authHeader && authHeader.startsWith('Bearer ') ? authHeader.substring(7).trim() : null;
+  const token = 
+    bearerToken ||
+    (req.headers['x-bootstrap-admin-key'] as string) ||
+    (req.headers['x-bootstrap-key'] as string) ||
+    (req.headers['x-bootstrap-token'] as string) ||
+    req.body?.bootstrapAdminKey ||
+    req.body?.bootstrapKey ||
+    req.body?.bootstrapToken;
+  const configuredSecret = process.env.BOOTSTRAP_ADMIN_KEY || process.env.BOOTSTRAP_SECRET || process.env.BOOTSTRAP_TOKEN;
 
   // Constant-time comparison to prevent timing attacks
   let isTokenValid = false;
diff --git a/server/postgres.ts b/server/postgres.ts
index 348d330..2a402bb 100644
--- a/server/postgres.ts
+++ b/server/postgres.ts
@@ -52,7 +52,7 @@ export function getPostgresPool(): pg.Pool | null {
       ssl: isLocalhost ? false : { rejectUnauthorized: true },
       max: 10,
       idleTimeoutMillis: 30000,
-      connectionTimeoutMillis: 5000,
+      connectionTimeoutMillis: 15000,
     });
 
     pool.on('error', (err) => {
@@ -81,7 +81,27 @@ export async function initPostgresTables(): Promise<boolean> {
     }
 
     try {
-      const client = await p.connect();
+      let client: pg.PoolClient | null = null;
+      let lastError: any = null;
+
+      for (let attempt = 1; attempt <= 3; attempt++) {
+        try {
+          client = await p.connect();
+          break;
+        } catch (connErr: any) {
+          lastError = connErr;
+          console.warn(`[PostgreSQL] Connection attempt ${attempt}/3 failed: ${connErr.message}. Retrying in 1.5s (handling Neon serverless wake-up)...`);
+          if (attempt < 3) {
+            await new Promise((r) => setTimeout(r, 1500));
+          }
+        }
+      }
+
+      if (!client) {
+        console.error('[PostgreSQL Initialization Error]:', lastError?.message || lastError);
+        return false;
+      }
+
       try {
         console.log('[PostgreSQL] Connected successfully to database. Ensuring tables exist...');
         
-- 
2.34.1

